# Server and database
DATABASE_URL=postgresql://user:password@host:5432/shotgun_ninja_village
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:24938
COMMUNITY_ALLOWED_ORIGINS=http://localhost:24938
COOKIE_SECURE=false

# Local Vite development (server-side API target; not a browser secret)
VITE_API_PROXY_TARGET=http://127.0.0.1:3000

# Optional live Shopify catalog
VITE_STORE_MODE=mock
VITE_SHOPIFY_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=
VITE_SHOPIFY_CHECKOUT_URL=
